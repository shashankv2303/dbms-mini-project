# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soundtrail
# Optional: pool size (default 10)
DB_POOL_MAX=10
# Long random string used to sign login cookies (JWT, HS256)
#   generate one with:  openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
